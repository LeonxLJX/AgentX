# ============================================================
# AgentX - .gitignore
# ============================================================

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Runtime artifacts
*.log
*.pid
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
outputs/
*.png
!examples/assets/*.png

# Local secrets / config
.env
*.local
